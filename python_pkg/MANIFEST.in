# File inclusion rules for the sdist (source distribution).
# For the wheel, pyproject.toml [tool.setuptools.package-data] is what decides;
# this MANIFEST only applies to the .tar.gz sdist produced by `python -m build`.

recursive-include src/bibexpy/_server *
recursive-include src/bibexpy/_web *
recursive-include src/bibex_core *.py
include README.md
include LICENSE

# Build artifacts / unneeded files
global-exclude __pycache__ *.py[cod] *.so .DS_Store
recursive-exclude src/bibexpy/_server storage *
recursive-exclude src/bibexpy/_server tests *
global-exclude .env
