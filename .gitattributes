# Line-ending normalization — the repo stores LF; shell scripts are ALWAYS LF (safe for CI/Linux),
# Windows scripts CRLF. This keeps scripts/build_wheel.sh from breaking in CI because of \r.
* text=auto eol=lf
*.sh   text eol=lf
*.ps1  text eol=crlf
*.bat  text eol=crlf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.whl  binary

# Sample datasets are kept byte-for-byte — the WoS export comes with CRLF; NO eol
# conversion/normalization (the packaged copy is identical to the original).
python_pkg/src/bibexpy/_samples/** -text
